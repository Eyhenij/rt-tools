{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "target": "es2022",
    "types": ["jest", "node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "rootDir": ".."
  },
  "include": ["jest.config.ts", "src/**/*.spec.ts", "src/testing/**/*.ts", "src/**/*.d.ts"]
}
