{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "target": "es2016",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node"],
    "isolatedModules": true,
    "rootDir": ".."
  },
  "files": ["src/test-setup.ts"],
  "include": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.d.ts", "src/testing/**/*.ts", "connect/src/**/*.spec.ts"]
}
