{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ui-kit-v2",
  "deleteDestPath": true,
  "inlineStyleLanguage": "scss",
  "assets": [
    "src/styles/**/*.scss",
    "src/assets",
    "src/lib/**/*.scss",
    "src/lib/**/CONTEXT.md",
    "src/rich-editor/**/*.scss",
    "src/rich-editor/**/CONTEXT.md"
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "allowedNonPeerDependencies": ["@rt-tools/core", "@rt-tools/utils"]
}
