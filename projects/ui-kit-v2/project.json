{
  "name": "@rt-tools/ui-kit-v2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "projects/ui-kit-v2/src",
  "prefix": "rt",
  "implicitDependencies": ["@rt-tools/core", "@rt-tools/utils"],
  "generators": {
    "@schematics/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush"
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "options": {
        "project": "projects/ui-kit-v2/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "projects/ui-kit-v2/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "projects/ui-kit-v2/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/ui-kit-v2"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "cacheable": false
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "projects/ui-kit-v2/jest.config.ts"
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 6007,
        "configDir": "projects/ui-kit-v2/.storybook",
        "browserTarget": "@rt-tools/ui-kit-v2:build-storybook",
        "compodoc": false,
        "styles": ["projects/ui-kit-v2/.storybook/storybook.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/@rt-tools/ui-kit-v2",
        "configDir": "projects/ui-kit-v2/.storybook",
        "browserTarget": "@rt-tools/ui-kit-v2:build-storybook",
        "compodoc": false,
        "styles": ["projects/ui-kit-v2/.storybook/storybook.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "{workspaceRoot}/dist/ui-kit-v2"
      }
    }
  }
}
