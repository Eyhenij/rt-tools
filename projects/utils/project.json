{
  "name": "@rt-tools/utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/utils/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/utils"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/utils"],
      "dependsOn": ["build:esm", "build:cjs"],
      "options": {
        "command": "node tools/finalize-utils-package.cjs"
      }
    },
    "build:esm": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/utils/esm"],
      "options": {
        "main": "projects/utils/src/index.ts",
        "tsConfig": "projects/utils/tsconfig.lib.esm.json",
        "outputPath": "dist/utils/esm",
        "generatePackageJson": false,
        "assets": [],
        "rootDir": "projects/utils/src"
      }
    },
    "build:cjs": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/utils/cjs"],
      "options": {
        "main": "projects/utils/src/index.ts",
        "tsConfig": "projects/utils/tsconfig.lib.cjs.json",
        "outputPath": "dist/utils/cjs",
        "generatePackageJson": false,
        "assets": [],
        "rootDir": "projects/utils/src"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/verify-utils-package.cjs"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/utils"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/projects/utils"],
      "options": {
        "jestConfig": "projects/utils/jest.config.ts",
        "tsConfig": "projects/utils/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
