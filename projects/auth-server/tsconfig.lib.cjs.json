{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "verbatimModuleSyntax": false,
    "outDir": "../../dist/auth-server/cjs",
    "declaration": false,
    "declarationMap": false,
    "types": [],
    "rootDir": "src",
    "paths": {
      "@rt-tools/auth-contract": ["../../dist/auth-contract/esm/index.d.ts"]
    }
  },
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "jest.config.ts", "jest.config.cts"],
  "include": ["src/**/*.ts"]
}
