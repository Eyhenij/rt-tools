{
  "name": "@rt/tools",
  "version": "0.0.13",
  "type": "module",
  "scripts": {
    "ng": "nx",
    "build:core": "rimraf dist/core && nx build @rt-tools/core --verbose",
    "build:store": "rimraf dist/store && nx build @rt-tools/store --verbose",
    "build:utils": "rimraf dist/utils && nx build @rt-tools/utils --verbose && nx verify @rt-tools/utils",
    "build:ui-kit": "rimraf dist/ui-kit && nx build @rt-tools/ui-kit --verbose && pnpm run build:tokens",
    "build:all": "pnpm run build:core && pnpm run build:store && pnpm run build:utils && pnpm run build:ui-kit",
    "watch": "nx build --watch --configuration development",
    "test": "pnpx nx run-many -t test",
    "lint": "pnpx nx run-many --target=lint --all",
    "prettier": "npx prettier --write ./projects",
    "check:all": "pnpm exec nx run-many -t lint test build --all --parallel",
    "check:affected": "pnpm exec nx affected -t lint test build --parallel",
    "packagr:core": "cd ./dist/core && npm pack && npm publish --access public",
    "packagr:store": "cd ./dist/store && npm pack && npm publish --access public",
    "packagr:utils": "cd ./dist/utils && npm pack && npm publish --access public",
    "packagr:ui-kit": "cd ./dist/ui-kit && npm pack && npm publish --access public",
    "storybook": "nx run @rt-tools/ui-kit:storybook --verbose",
    "build-storybook": "nx run @rt-tools/ui-kit:build-storybook --verbose",
    "graph": "pnpx nx dep-graph",
    "changelog:core": "conventional-changelog -p angular -i projects/core/CHANGELOG.md -s -k projects/core/package.json --commit-path projects/core --tag-prefix rt-core@ && node tools/fold-unreleased-changelog.cjs projects/core/CHANGELOG.md",
    "changelog:store": "conventional-changelog -p angular -i projects/store/CHANGELOG.md -s -k projects/store/package.json --commit-path projects/store --tag-prefix rt-store@ && node tools/fold-unreleased-changelog.cjs projects/store/CHANGELOG.md",
    "changelog:utils": "conventional-changelog -p angular -i projects/utils/CHANGELOG.md -s -k projects/utils/package.json --commit-path projects/utils --tag-prefix rt-utils@ && node tools/fold-unreleased-changelog.cjs projects/utils/CHANGELOG.md",
    "changelog:ui-kit": "conventional-changelog -p angular -i projects/ui-kit/CHANGELOG.md -s -k projects/ui-kit/package.json --commit-path projects/ui-kit --tag-prefix rt-tools@ && node tools/fold-unreleased-changelog.cjs projects/ui-kit/CHANGELOG.md",
    "prepare": "husky",
    "postinstall": "rimraf .angular .nx",
    "preinstall": "npx only-allow pnpm",
    "build:tokens": "sass --no-source-map projects/ui-kit/src/styles/tokens.scss dist/ui-kit/styles/tokens.css"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Eyhenij/rt-tools"
  },
  "keywords": [
    "Angular",
    "Tools",
    "UI-Kit",
    "Utils"
  ],
  "license": "Apache-2.0",
  "workspaces": [
    "projects/core",
    "projects/store",
    "projects/utils",
    "projects/ui-kit"
  ],
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "ngx-image-cropper": "^9.1.6"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.5",
    "@angular-devkit/core": "22.0.5",
    "@angular-devkit/schematics": "22.0.5",
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/schematics": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/animations": "22.0.5",
    "@angular/cdk": "22.0.3",
    "@angular/cli": "22.0.5",
    "@angular/common": "22.0.5",
    "@angular/compiler": "22.0.5",
    "@angular/compiler-cli": "22.0.5",
    "@angular/core": "22.0.5",
    "@angular/forms": "22.0.5",
    "@angular/material": "22.0.3",
    "@angular/platform-browser": "22.0.5",
    "@angular/platform-browser-dynamic": "22.0.5",
    "@angular/router": "22.0.5",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-angular": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "@nx/angular": "23.1.0-rc.0",
    "@nx/eslint-plugin": "23.1.0-rc.0",
    "@nx/jest": "23.1.0-rc.0",
    "@nx/js": "23.1.0-rc.0",
    "@nx/storybook": "23.1.0-rc.0",
    "@nx/web": "23.1.0-rc.0",
    "@nx/workspace": "23.1.0-rc.0",
    "@schematics/angular": "22.0.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/angular": "10.1.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.43",
    "@swc/helpers": "0.5.23",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/utils": "^8.65.0",
    "angular-eslint": "22.0.0",
    "autoprefixer": "^10.5.4",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "17.0.0",
    "jest-util": "30.4.1",
    "jsonc-eslint-parser": "^2.4.2",
    "lint-staged": "^17.2.0",
    "ng-packagr": "22.0.1",
    "nx": "23.1.0-rc.0",
    "postcss": "^8.5.25",
    "postcss-url": "~10.1.4",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "sass": "^1.102.0",
    "storybook": "^10.5.5",
    "stylelint": "^16.26.1",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.14.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "verdaccio": "6.7.4"
  },
  "lint-staged": {
    "**/src/**/*.{js,ts}": "eslint --fix",
    "**/src/**/*.{js,ts,json,mdx,md,html,scss,css}": "prettier . --write"
  },
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=11.10.0"
  },
  "packageManager": "pnpm@11.10.0",
  "nx": {
    "includedScripts": []
  }
}
