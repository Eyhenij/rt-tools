{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "forceConsistentCasingInFileNames": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"],
    "types": ["node"],
    "paths": {
      "@rt-tools/core": ["projects/core/src/index.ts"],
      "@rt-tools/store": ["projects/store/src/index.ts"],
      "@rt-tools/utils": ["projects/utils/src/index.ts"],
      "@rt-tools/ui-kit": ["projects/ui-kit/src/public-api.ts"],
      "@rt-tools/ui-kit-v2": ["projects/ui-kit-v2/src/public-api.ts"],
      "@rt-tools/agent-kit/cargo": ["projects/agent-kit/src/lib/cargo.ts"],
      "@rt/message-bus-api/observations/util": ["./libs/message-bus-api/observations/util/src/index.ts"],
      "@rt/message-bus-api/observations/data-access": ["./libs/message-bus-api/observations/data-access/src/index.ts"],
      "@rt/message-bus-api/observations/feature": ["./libs/message-bus-api/observations/feature/src/index.ts"],
      "@rt/message-bus-api/observations/api": ["./libs/message-bus-api/observations/api/src/index.ts"],
      "@rt/message-bus-api/proposals/util": ["./libs/message-bus-api/proposals/util/src/index.ts"],
      "@rt/message-bus-api/proposals/data-access": ["./libs/message-bus-api/proposals/data-access/src/index.ts"],
      "@rt/message-bus-api/proposals/feature": ["./libs/message-bus-api/proposals/feature/src/index.ts"],
      "@rt/message-bus-api/proposals/api": ["./libs/message-bus-api/proposals/api/src/index.ts"],
      "@rt/message-bus-api/postmortems/util": ["./libs/message-bus-api/postmortems/util/src/index.ts"],
      "@rt/message-bus-api/postmortems/data-access": ["./libs/message-bus-api/postmortems/data-access/src/index.ts"],
      "@rt/message-bus-api/postmortems/feature": ["./libs/message-bus-api/postmortems/feature/src/index.ts"],
      "@rt/message-bus-api/postmortems/api": ["./libs/message-bus-api/postmortems/api/src/index.ts"],
      "@rt/message-bus-common": ["./libs/message-bus-common/src/index.ts"],
      "@rt/message-bus-api/persistence/util": ["./libs/message-bus-api/persistence/util/src/index.ts"],
      "@rt/message-bus-api/persistence/data-access": ["./libs/message-bus-api/persistence/data-access/src/index.ts"],
      "@rt/message-bus-api/persistence/feature": ["./libs/message-bus-api/persistence/feature/src/index.ts"],
      "@rt/message-bus-api/persistence/api": ["./libs/message-bus-api/persistence/api/src/index.ts"],
      "@rt/message-bus-api/trees/util": ["./libs/message-bus-api/trees/util/src/index.ts"],
      "@rt/message-bus-api/trees/data-access": ["./libs/message-bus-api/trees/data-access/src/index.ts"],
      "@rt/message-bus-api/trees/feature": ["./libs/message-bus-api/trees/feature/src/index.ts"],
      "@rt/message-bus-api/trees/api": ["./libs/message-bus-api/trees/api/src/index.ts"],
      "@rt/message-bus-api/accounts/util": ["./libs/message-bus-api/accounts/util/src/index.ts"],
      "@rt/message-bus-api/accounts/data-access": ["./libs/message-bus-api/accounts/data-access/src/index.ts"],
      "@rt/message-bus-api/accounts/feature": ["./libs/message-bus-api/accounts/feature/src/index.ts"],
      "@rt/message-bus-api/accounts/api": ["./libs/message-bus-api/accounts/api/src/index.ts"],
      "@rt/message-bus-api/access/util": ["./libs/message-bus-api/access/util/src/index.ts"],
      "@rt/message-bus-api/access/data-access": ["./libs/message-bus-api/access/data-access/src/index.ts"],
      "@rt/message-bus-api/access/feature": ["./libs/message-bus-api/access/feature/src/index.ts"],
      "@rt/message-bus-api/access/api": ["./libs/message-bus-api/access/api/src/index.ts"]
    },
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "compilationMode": "partial"
  },
  "exclude": ["node_modules", "dist"]
}
