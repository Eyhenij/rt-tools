# Auto detect text files and perform LF normalization
* text=auto

# SCSS, JS and TS files must always use LF for tools to work
*.js eol=lf
*.ts eol=lf
*.scss eol=lf

# Указатели, в которые ветки только дописывают строки.
#
# Каждая закрытая работа добавляет строку в конец одной и той же таблицы, и две ветки, дописавшие
# по строке, встают конфликтом на пустом месте: терять нечего, обе стороны нужны целиком. Хуже
# того, конфликт возвращается после каждого слияния в главную ветку — за один заход одна и та же
# строка разрешалась шесть раз, и трижды владелец отбил пуш, приняв работу за зависшую.
#
# `union` складывает обе стороны и человека не зовёт. Цена: если обе стороны правят одну и ту же
# строку прозы по-разному, в файле останутся обе — поэтому union стоит только на указателях, где
# правка всегда добавляющая, а не на текстах, которые переписывают.
docs/archive/README.md merge=union
docs/specs/README.md merge=union
