// Хранилище приёмника груза. Семь сущностей договорённостей `docs/specs/message-bus/` и
// `docs/specs/message-bus/proposed/admin-console/`; правила, которые выражают ограничения, там же.

generator client {
    provider            = "prisma-client"
    output              = "../libs/message-bus-api/persistence/util/src/generated/prisma"
    runtime             = "nodejs"
    moduleFormat        = "cjs"
    importFileExtension = ""
}

// Адрес хранилища живёт в `prisma.config.ts`: седьмая редакция Prisma не принимает его в схеме.
datasource db {
    provider = "postgresql"
}

/// Состояние записи груза: на каком шаге стоит разбор происшествия или предложение.
///
/// Набор объявлен и здесь, и перечислением общей либы — приёмник и админка читают одно и то же
/// слово. Сходство двух объявлений держит спека: разъехавшись, они дали бы состояние, которого
/// экран не знает, и показали бы его машинной строкой.
///
/// Готовое и выпущенное разведены не для порядка: между починкой и выпуском стоит редакция
/// пакета, и потребитель получает фикс только после раскладки у себя.
enum CargoState {
    /// Запись приехала, и с ней ещё ничего не делали.
    new
    /// Запись взята в разбор.
    in_work
    /// Недочёт починен, но выпуска с починкой ещё не было.
    fixed
    /// Починка уехала выпуском.
    released
}

/// Дерево, от которого приезжает груз. Признак считает само дерево от адреса своего
/// репозитория; приёмник его только сверяет и по нему не восстанавливает адреса.
model Tree {
    id        String   @id @default(uuid())
    /// Признак дерева: им груз называет отправителя.
    slug      String   @unique
    /// Читаемое имя: его называет владелец при заведении.
    name      String   @unique
    createdAt DateTime @default(now())

    tokens      TreeToken[]
    months      MonthRecord[]
    postmortems Postmortem[]
    proposals   Proposal[]
    invites     TreeInvite[]

    @@map("tree")
}

/// Приглашение: одноразовый код, выданный владельцем под одно дерево. По нему дерево один раз
/// получает свой токен, после чего приглашение гаснет. В хранилище лежит только хеш кода — тем
/// же приёмом, что и у токена: снятый дамп не даёт ни одного годного кода.
model TreeInvite {
    id         String    @id @default(uuid())
    hash       String    @unique
    /// Имя будущего дерева: его называет владелец при выдаче, а обращение не передаёт вовсе.
    name       String
    /// То же имя, пока приглашение годно; при погашении и отзыве гасится в пусто. Так «одно
    /// годное приглашение на имя» держит хранилище, а прежние приглашения остаются лежать:
    /// уникальность в постгресе пустых значений не считает.
    activeName String?   @unique
    issuedAt   DateTime  @default(now())
    /// После этого времени приглашение не принимается, даже если им не пользовались.
    expiresAt  DateTime
    /// Пусто — приглашением ещё не воспользовались.
    redeemedAt DateTime?
    /// Пусто — приглашение не отзывали.
    revokedAt  DateTime?
    /// Дерево, заведённое этим приглашением: заполняется в момент погашения.
    treeId     String?
    tree       Tree?     @relation(fields: [treeId], references: [id], onDelete: SetNull)

    @@index([treeId])
    @@map("tree_invite")
}

/// Токен дерева. В хранилище лежит только хеш: по нему токен не восстанавливается, и утёкший
/// дамп доступа не даёт. Годен у дерева один — новый замещает прежний, помечая его отозванным.
model TreeToken {
    id        String    @id @default(uuid())
    treeId    String
    tree      Tree      @relation(fields: [treeId], references: [id], onDelete: Cascade)
    hash      String    @unique
    issuedAt  DateTime  @default(now())
    /// Пусто — токен годен. Отозванный не удаляется: по нему читается прежний груз.
    revokedAt DateTime?

    @@index([treeId])
    @@map("tree_token")
}

/// Свод одного дерева за один календарный месяц. Одна запись на пару «дерево — месяц»:
/// уникальность держит хранилище, потому что два прогона приезжают одновременно.
model MonthRecord {
    id     String @id @default(uuid())
    treeId String
    tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
    /// Месяц в форме `2026-08`, по всемирному времени приёмника.
    month  String

    /// Сводка последнего прогона целиком: счётчики, снимок надстроек, невыбранное. Приёмник её
    /// не разбирает — колонка под каждое поле разъезжалась бы с пакетом при первой его правке.
    ///
    /// Пусто — сводки в этом месяце ещё не было: запись завели предложения или разборы,
    /// приехавшие раньше неё. Пустой объект сказал бы то же самое неотличимо от сводки с
    /// нулевыми счётчиками, а такая сводка законна: у дерева бывает месяц без единого наблюдения.
    summary Json?
    /// Версия схемы груза, которой назвался последний прогон. Незнакомая принимается как есть.
    /// Ставит её любой род груза: версия — свойство прогона, а не одной только сводки.
    schema  String
    /// Время последнего прогона: по нему видно, отчитывается ли дерево вообще.
    ranAt   DateTime @default(now())

    proposals Proposal[]

    @@unique([treeId, month])
    @@map("month_record")
}

/// Предложение по слою правил. Копится, а не замещается: сводка отвечает на вопрос «как дела
/// сейчас», предложения — «что случилось за месяц».
model Proposal {
    id       String      @id @default(uuid())
    recordId String
    record   MonthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
    /// Дерево, от которого предложение приехало. Стоит своей колонкой, а не читается через
    /// запись месяца: ограничение хранилища читает колонки одной строки.
    treeId   String
    tree     Tree        @relation(fields: [treeId], references: [id], onDelete: Cascade)
    /// Текст предложения целиком.
    text     String
    /// Признак предложения: хеш его текста. Им предложение отличается от уже приехавшего — в
    /// любом месяце, а не в одном. Хеш, а не сам текст: уникальность по полю в килобайты
    /// упирается в предел размера строки индекса.
    digest   String
    /// Адрес правки: пакет, дерево или компаньон.
    address  String
    /// Ресурс слоя правил, к которому предложение относится. По нему берётся счёт «сколько
    /// деревьев правят это место» — ради него линия работ и заведена.
    resource String
    /// На каком шаге разбора стоит предложение. Умолчание держит хранилище: запись, заведённая
    /// мимо приёма, иначе приезжала бы без состояния, и читающий видел бы пустоту.
    state     CargoState @default(new)
    /// Чем недочёт исправлен. Приезжает вместе с переходом в `fixed` и без него не приезжает
    /// вовсе; у записи, которую никто не чинил, пусто. По полю не ищут и не сортируют.
    fixNote   String?
    /// В какой версии искать фикс. Приезжает вместе с переходом в `released` и без него не
    /// приезжает вовсе; у записи, которую никто не выпускал, пусто. Форма принадлежит дереву:
    /// приёмник её не разбирает — номера читаются при чтении списка. По полю отбирают,
    /// упорядочивают и собирают встретившиеся значения, поэтому оно несёт индекс.
    releaseVersion String?
    /// Закрыл ли запись издатель редакции, а не приславшее её дерево. Своей колонкой, а не
    /// выводом из состояния: поле состояния одно, и кто его двинул, после правки не видно никак,
    /// — а отправитель, увидевший свою запись выпущенной, иначе читает это как свою отметку.
    closedByPublisher Boolean @default(false)
    arrivedAt DateTime   @default(now())

    @@unique([treeId, digest])
    @@index([recordId])
    @@index([treeId])
    @@index([releaseVersion])
    @@map("proposal")
}

/// Разбор происшествия: текст целиком, как он лежит на дереве. Опознаётся именем файла —
/// заголовок правится вместе с текстом, а имя файла правку переживает.
model Postmortem {
    id        String   @id @default(uuid())
    treeId    String
    tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
    /// Имя файла разбора на дереве.
    file      String
    text      String
    /// На каком шаге разбора стоит запись. Приезд с другим текстом возвращает её в `new`: текст,
    /// ставший другим, разбирается заново.
    state     CargoState @default(new)
    /// Чем недочёт исправлен. Приезжает вместе с переходом в `fixed` и без него не приезжает
    /// вовсе; у записи, которую никто не чинил, пусто. По полю не ищут и не сортируют.
    fixNote   String?
    /// В какой версии искать фикс. Приезжает вместе с переходом в `released` и без него не
    /// приезжает вовсе; у записи, которую никто не выпускал, пусто. Форма принадлежит дереву:
    /// приёмник её не разбирает — номера читаются при чтении списка. По полю отбирают,
    /// упорядочивают и собирают встретившиеся значения, поэтому оно несёт индекс.
    releaseVersion String?
    /// Закрыл ли запись издатель редакции, а не приславшее её дерево — как у предложения.
    closedByPublisher Boolean @default(false)
    arrivedAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([treeId, file])
    @@index([treeId])
    @@index([releaseVersion])
    @@map("postmortem")
}

/// Учётная запись человека, читающего груз. Заводится командой строки запуска: заведения из
/// веба нет вовсе, и первую запись некому было бы завести.
model Account {
    id           String    @id @default(uuid())
    /// Имя, как его назвал владелец: им запись показывается в списке команд.
    name         String
    /// То же имя, приведённое к одному виду. Уникальность держит хранилище по нему, а не по
    /// `name`: `Иван` рядом с `иван` означает, что вход перестал отвечать, кто именно вошёл.
    nameKey      String    @unique
    /// Пароль лежит только хешем: снятый дамп базы входа не даёт.
    passwordHash String
    /// Пусто — запись действует. Отключённая входа не заводит, а её прежние входы обрываются.
    disabledAt   DateTime?
    createdAt    DateTime  @default(now())
    /// Пусто — этой записью ещё не входили. Показывается командой списка.
    lastLoginAt  DateTime?

    sessions Session[]

    @@map("account")
}

/// Вход: то, чем браузер представляется приёмнику между запросами. В хранилище лежит только
/// хеш — по нему вход не подделывается, а сам он живёт в куке, недоступной скриптам.
model Session {
    id        String   @id @default(uuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    hash      String   @unique
    issuedAt  DateTime @default(now())
    /// После этого времени вход не принимается: человек представляется заново.
    expiresAt DateTime
    /// Пусто — вход жив. Ставится выходом и отключением записи; сам вход не удаляется, чтобы
    /// оборванный отличался от неизвестного.
    revokedAt DateTime?

    @@index([accountId])
    @@map("session")
}
