// Хранилище приёмника груза. Семь сущностей договорённостей `docs/specs/message-bus/` и
// `docs/specs/message-bus/proposed/admin-console/`; правила, которые выражают ограничения, там же.

generator client {
    provider            = "prisma-client"
    output              = "../libs/message-bus-api/persistence/util/src/generated/prisma"
    runtime             = "nodejs"
    moduleFormat        = "cjs"
    importFileExtension = ""
}

// Адрес хранилища живёт в `prisma.config.ts`: седьмая редакция Prisma не принимает его в схеме.
datasource db {
    provider = "postgresql"
}

/// Состояние записи груза: на каком шаге стоит разбор происшествия или предложение.
///
/// Набор объявлен и здесь, и перечислением общей либы — приёмник и админка читают одно и то же
/// слово. Сходство двух объявлений держит спека: разъехавшись, они дали бы состояние, которого
/// экран не знает, и показали бы его машинной строкой.
///
/// Готовое и выпущенное разведены не для порядка: между починкой и выпуском стоит редакция
/// пакета, и потребитель получает фикс только после раскладки у себя.
enum CargoState {
    /// Запись приехала, и с ней ещё ничего не делали.
    new
    /// Запись взята в разбор.
    in_work
    /// Недочёт починен, но выпуска с починкой ещё не было.
    fixed
    /// Починка уехала выпуском.
    released
    /// Запись разобрана и признана спорной: работой она не становится, пока человек не скажет
    /// иначе. Стоит в наборе последней, а не между `new` и `in_work`: шага по порядку она не
    /// составляет — из неё ходят только назад, в `new`.
    quarantined
}

/// Дерево, от которого приезжает груз. Признак считает само дерево от адреса своего
/// репозитория; приёмник его только сверяет и по нему не восстанавливает адреса.
model Tree {
    id        String   @id @default(uuid())
    /// Признак дерева: им груз называет отправителя.
    slug      String   @unique
    /// Читаемое имя: его называет владелец при заведении.
    name      String   @unique
    createdAt DateTime @default(now())

    tokens      TreeToken[]
    months      MonthRecord[]
    postmortems  Postmortem[]
    proposals    Proposal[]
    invites      TreeInvite[]
    observations Observation[]

    @@map("tree")
}

/// Приглашение: одноразовый код, выданный владельцем под одно дерево. По нему дерево один раз
/// получает свой токен, после чего приглашение гаснет. В хранилище лежит только хеш кода — тем
/// же приёмом, что и у токена: снятый дамп не даёт ни одного годного кода.
model TreeInvite {
    id         String    @id @default(uuid())
    hash       String    @unique
    /// Имя будущего дерева: его называет владелец при выдаче, а обращение не передаёт вовсе.
    name       String
    /// То же имя, пока приглашение годно; при погашении и отзыве гасится в пусто. Так «одно
    /// годное приглашение на имя» держит хранилище, а прежние приглашения остаются лежать:
    /// уникальность в постгресе пустых значений не считает.
    activeName String?   @unique
    issuedAt   DateTime  @default(now())
    /// После этого времени приглашение не принимается, даже если им не пользовались.
    expiresAt  DateTime
    /// Пусто — приглашением ещё не воспользовались.
    redeemedAt DateTime?
    /// Пусто — приглашение не отзывали.
    revokedAt  DateTime?
    /// Дерево, заведённое этим приглашением: заполняется в момент погашения.
    treeId     String?
    tree       Tree?     @relation(fields: [treeId], references: [id], onDelete: SetNull)

    @@index([treeId])
    @@map("tree_invite")
}

/// Токен дерева. В хранилище лежит только хеш: по нему токен не восстанавливается, и утёкший
/// дамп доступа не даёт. Годен у дерева один — новый замещает прежний, помечая его отозванным.
model TreeToken {
    id        String    @id @default(uuid())
    treeId    String
    tree      Tree      @relation(fields: [treeId], references: [id], onDelete: Cascade)
    hash      String    @unique
    issuedAt  DateTime  @default(now())
    /// Пусто — токен годен. Отозванный не удаляется: по нему читается прежний груз.
    revokedAt DateTime?

    @@index([treeId])
    @@map("tree_token")
}

/// Свод одного дерева за один календарный месяц. Одна запись на пару «дерево — месяц»:
/// уникальность держит хранилище, потому что два прогона приезжают одновременно.
model MonthRecord {
    id     String @id @default(uuid())
    treeId String
    tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
    /// Месяц в форме `2026-08`, по всемирному времени приёмника.
    month  String

    /// Сводка последнего прогона целиком: счётчики, снимок надстроек, невыбранное. Приёмник её
    /// не разбирает — колонка под каждое поле разъезжалась бы с пакетом при первой его правке.
    ///
    /// Пусто — сводки в этом месяце ещё не было: запись завели предложения или разборы,
    /// приехавшие раньше неё. Пустой объект сказал бы то же самое неотличимо от сводки с
    /// нулевыми счётчиками, а такая сводка законна: у дерева бывает месяц без единого наблюдения.
    summary Json?
    /// Версия схемы груза, которой назвался последний прогон. Незнакомая принимается как есть.
    /// Ставит её любой род груза: версия — свойство прогона, а не одной только сводки.
    schema  String
    /// Время последнего прогона: по нему видно, отчитывается ли дерево вообще.
    ranAt   DateTime @default(now())

    proposals Proposal[]

    @@unique([treeId, month])
    @@map("month_record")
}

/// Одна строка наблюдения дерева — как лежала в файле дня, плюс дерево и день. Приёмник строки
/// не сводит при приёме: сводит хранилище при чтении, по дереву и отрезку дней.
///
/// День одной рабочей копии замещается целиком: окна прогонов перекрываются по дням, и строка,
/// оставшаяся от прошлого прогона, считалась бы дважды. Копия названа своим признаком, потому
/// что у одного дерева их несколько, а признак дерева у них общий.
model Observation {
    id     String @id @default(uuid())
    treeId String
    tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
    /// Признак рабочей копии: контрольная сумма её корня, как назвал груз.
    origin String
    /// День строки в форме `2026-09-14`, как назван файл дня у дерева.
    day    String
    /// Время события, как записал гард дерева.
    t      DateTime
    /// Событие: загрузка скила, отказ гейта правил, отказ гарда, исход проверки перед push.
    ev     String
    /// Ресурс: правило, скил или гард, о котором событие.
    res    String
    /// Род правленого файла при отказе гейта; у остальных пусто.
    kind   String?
    /// Род скила у загрузки: правило, паттерн, скил пакета, свой скил дерева; у остальных пусто.
    skill  String?
    /// Признак сессии: контрольная сумма, по которой сессии считаются и не называются.
    sid    String
    /// Версия пакета, которая записала строку.
    v      String

    @@index([treeId, day])
    @@index([treeId, origin, day])
    @@map("observation")
}

/// Предложение по слою правил. Копится, а не замещается: сводка отвечает на вопрос «как дела
/// сейчас», предложения — «что случилось за месяц».
model Proposal {
    id       String      @id @default(uuid())
    recordId String
    record   MonthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
    /// Дерево, от которого предложение приехало. Стоит своей колонкой, а не читается через
    /// запись месяца: ограничение хранилища читает колонки одной строки.
    treeId   String
    tree     Tree        @relation(fields: [treeId], references: [id], onDelete: Cascade)
    /// Текст предложения целиком.
    text     String
    /// Признак предложения: хеш его текста. Им предложение отличается от уже приехавшего — в
    /// любом месяце, а не в одном. Хеш, а не сам текст: уникальность по полю в килобайты
    /// упирается в предел размера строки индекса.
    digest   String
    /// Адрес правки: пакет, дерево или компаньон.
    address  String
    /// Ресурс слоя правил, к которому предложение относится. По нему берётся счёт «сколько
    /// деревьев правят это место» — ради него линия работ и заведена.
    resource String
    /// На каком шаге разбора стоит предложение. Умолчание держит хранилище: запись, заведённая
    /// мимо приёма, иначе приезжала бы без состояния, и читающий видел бы пустоту.
    state     CargoState @default(new)
    /// Чем недочёт исправлен. Приезжает вместе с переходом в `fixed` и без него не приезжает
    /// вовсе; у записи, которую никто не чинил, пусто. По полю не ищут и не сортируют.
    fixNote   String?
    /// В какой версии искать фикс. Приезжает вместе с переходом в `released` и без него не
    /// приезжает вовсе; у записи, которую никто не выпускал, пусто. Форма принадлежит дереву:
    /// приёмник её не разбирает — номера читаются при чтении списка. По полю отбирают,
    /// упорядочивают и собирают встретившиеся значения, поэтому оно несёт индекс.
    releaseVersion String?
    /// Чем запись спорна. Приезжает вместе с переходом в `quarantined` и без него не приезжает
    /// вовсе; у записи, которая в карантине не была, пусто. По полю не ищут и не сортируют.
    quarantineNote String?
    /// Закрыл ли запись издатель редакции, а не приславшее её дерево. Своей колонкой, а не
    /// выводом из состояния: поле состояния одно, и кто его двинул, после правки не видно никак,
    /// — а отправитель, увидевший свою запись выпущенной, иначе читает это как свою отметку.
    closedByPublisher Boolean @default(false)
    arrivedAt DateTime   @default(now())

    @@unique([treeId, digest])
    @@index([recordId])
    @@index([treeId])
    @@index([releaseVersion])
    @@map("proposal")
}

/// Разбор происшествия: текст целиком, как он лежит на дереве. Опознаётся именем файла —
/// заголовок правится вместе с текстом, а имя файла правку переживает.
model Postmortem {
    id        String   @id @default(uuid())
    treeId    String
    tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
    /// Имя файла разбора на дереве.
    file      String
    text      String
    /// На каком шаге разбора стоит запись. Приезд с другим текстом возвращает её в `new`: текст,
    /// ставший другим, разбирается заново.
    state     CargoState @default(new)
    /// Чем недочёт исправлен. Приезжает вместе с переходом в `fixed` и без него не приезжает
    /// вовсе; у записи, которую никто не чинил, пусто. По полю не ищут и не сортируют.
    fixNote   String?
    /// В какой версии искать фикс. Приезжает вместе с переходом в `released` и без него не
    /// приезжает вовсе; у записи, которую никто не выпускал, пусто. Форма принадлежит дереву:
    /// приёмник её не разбирает — номера читаются при чтении списка. По полю отбирают,
    /// упорядочивают и собирают встретившиеся значения, поэтому оно несёт индекс.
    releaseVersion String?
    /// Чем запись спорна. Приезжает вместе с переходом в `quarantined` и без него не приезжает
    /// вовсе; у записи, которая в карантине не была, пусто. По полю не ищут и не сортируют.
    quarantineNote String?
    /// Закрыл ли запись издатель редакции, а не приславшее её дерево — как у предложения.
    closedByPublisher Boolean @default(false)
    arrivedAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([treeId, file])
    @@index([treeId])
    @@index([releaseVersion])
    @@map("postmortem")
}

/// Учётная запись человека, читающего груз. Заводится командой строки запуска: заведения из
/// веба нет вовсе, и первую запись некому было бы завести.
model Account {
    id           String    @id @default(uuid())
    /// Имя, как его назвал владелец: им запись показывается в списке команд.
    name         String
    /// То же имя, приведённое к одному виду. Уникальность держит хранилище по нему, а не по
    /// `name`: `Иван` рядом с `иван` означает, что вход перестал отвечать, кто именно вошёл.
    nameKey      String    @unique
    /// Пароль лежит только хешем: снятый дамп базы входа не даёт.
    passwordHash String
    /// Пусто — запись действует. Отключённая входа не заводит, а её прежние входы обрываются.
    disabledAt   DateTime?
    createdAt    DateTime  @default(now())
    /// Пусто — этой записью ещё не входили. Показывается командой списка.
    lastLoginAt  DateTime?

    /// Роль записи. Пусто — роли не назначено, и прав у человека нет ни одного: он входит и не
    /// видит ни одного раздела. Это законное состояние, а не поломка — заведение и назначение
    /// роли разведены во времени.
    ///
    /// Роль одна, а не набор: две пришлось бы складывать, а исход сложения разрешения и запрета
    /// по двум строкам не прочитывается.
    roleId       String?
    role         Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

    sessions    Session[]
    permissions AccountPermission[]

    @@index([roleId])
    @@map("account")
}

/// Роль: именованный набор прав, выдаваемый человеку целиком.
///
/// Сами права — закрытый список в коде, а не таблица: право называет объявление операции, и
/// объявление ссылается на имя, которое есть. Строка таблицы прав позволила бы завести право,
/// которого не читает ни одна операция, и от опечатки её не отличить.
model Role {
    id        String   @id @default(uuid())
    /// Ключ роли: им на роль ссылаются код и засев. Не показывается человеку.
    key       String   @unique
    /// Имя, как его видит человек в списке ролей.
    name      String   @unique
    /// Набор прав роли: строки вида «раздел:действие». Право, которого в списке нет, роль не
    /// даёт — молчание не разрешение.
    rights    String[]
    createdAt DateTime @default(now())

    accounts Account[]

    @@map("role")
}

/// Точечная правка права поверх роли: одно право, данное или отнятое у одного человека.
///
/// Строки на право нет — решает роль. Строка есть — решает она, и роль в этом праве молчит.
model AccountPermission {
    id        String  @id @default(uuid())
    accountId String
    account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    /// Право, о котором правка: строка вида «раздел:действие», из того же закрытого списка.
    right     String
    /// Дано право или отнято. Не «есть строка — значит дано»: отнять право, которое даёт роль,
    /// иначе нечем.
    granted   Boolean

    @@unique([accountId, right])
    @@index([accountId])
    @@map("account_permission")
}

/// Вход: то, чем браузер представляется приёмнику между запросами. В хранилище лежит только
/// хеш — по нему вход не подделывается, а сам он живёт в куке, недоступной скриптам.
model Session {
    id        String   @id @default(uuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    hash      String   @unique
    issuedAt  DateTime @default(now())
    /// После этого времени вход не принимается: человек представляется заново.
    expiresAt DateTime
    /// Пусто — вход жив. Ставится выходом и отключением записи; сам вход не удаляется, чтобы
    /// оборванный отличался от неизвестного.
    revokedAt DateTime?

    @@index([accountId])
    @@map("session")
}

/// Сторона сообщения: кто его написал. Двух слов хватает на весь эпик — отвечают посетителю
/// операторы, а не служба: ответа машины договорённость не обещает.
enum ChatSide {
    /// Написал посетитель сайта.
    visitor
    /// Написал оператор пространства.
    operator
}

/// Пространство чата: сайты и операторы одного клиента сервиса. Всё, что есть у чата, лежит
/// внутри пространства — без этого клиент увидел бы переписки соседа по первой ошибке в адресе.
model ChatSpace {
    id        String   @id @default(uuid())
    /// Читаемое имя: его называет владелец при заведении.
    name      String   @unique
    createdAt DateTime @default(now())

    sites     ChatSite[]
    operators ChatOperator[]

    @@map("chat_space")
}

/// Сайт: площадка, на которой стоит виджет. Принадлежит одному пространству и несёт свой ключ.
model ChatSite {
    id      String    @id @default(uuid())
    spaceId String
    space   ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    /// Читаемое имя площадки: по нему оператор отличает сайты в панели.
    name    String
    /// Ключ сайта: открытый признак, которым виджет называет сайт. Лежит в скрипте страницы и
    /// тайной не является — прав, кроме приёма реплики, он не даёт.
    key     String    @unique
    /// Адреса страниц, с которых зовут операции этого сайта. Пустой список отказывает всему:
    /// сайт, у которого он не заполнен, ещё никуда не поставлен.
    origins String[]
    /// Выключенный сайт отвечает как неизвестный: по ответу эти две причины не различаются.
    enabled Boolean   @default(true)
    /// Приветствие площадки: его виджет показывает до первой реплики. Пусто — виджет открывается
    /// сразу полем набора, и это законное состояние площадки, которой сказать нечего.
    greeting String    @default("")
    /// Часы ответа минутами суток в часовом поясе площадки. Равные значения означают, что часы
    /// не названы: виджет тогда молчит о них и ничего не обещает.
    answerFrom Int     @default(0)
    answerTo   Int     @default(0)
    /// Часовой пояс площадки именем базы поясов. Пусто — часы считаются по поясу узла.
    timeZone   String  @default("")
    /// Адрес, по которому сервис зовёт приложение площадки. Пусто — площадка вызовов наружу не
    /// получает вовсе, и это законное её состояние.
    hookUrl    String  @default("")
    /// Тайна подписи вызова: ею приложение отличает сервис от любого, кто узнал адрес. Без неё
    /// вызовы не уходят — площадка с адресом, но без тайны настроена наполовину.
    hookSecret String  @default("")
    /// Через сколько минут без ответа переписка будит оператора. Ноль — будильник выключен.
    answerWithin Int   @default(0)
    createdAt DateTime @default(now())

    visitors      ChatVisitor[]
    conversations ChatConversation[]
    operators     ChatOperatorSite[]

    @@index([spaceId])
    @@map("chat_site")
}

/// Посетитель: тот, кто пишет с сайта без входа. Узнаётся признаком, который выдал сервис, —
/// придуманный страницей опознаватель дал бы читать чужую переписку по догадке.
model ChatVisitor {
    id     String   @id @default(uuid())
    siteId String
    site   ChatSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
    /// Признак посетителя, как он выдан виджету. Открывает одну переписку одного сайта и
    /// ничего кроме неё.
    token  String
    /// Минута первого обращения: по ней видно, когда посетитель пришёл впервые.
    firstSeenAt DateTime @default(now())

    conversations ChatConversation[]

    @@unique([siteId, token])
    @@map("chat_visitor")
}

/// Переписка: разговор одного посетителя на одном сайте. Живая переписка у посетителя одна —
/// иначе перезагрузка страницы рвала бы разговор на куски, которые оператор видит как разных людей.
model ChatConversation {
    id        String      @id @default(uuid())
    siteId    String
    site      ChatSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
    visitorId String      @unique
    visitor   ChatVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
    createdAt DateTime    @default(now())
    /// Минута последнего сообщения: по ней панель оператора ставит переписки по свежести.
    lastMessageAt DateTime @default(now())
    /// Жива переписка или закрыта. Заводится живой: закрывает её оператор, а реплика посетителя
    /// открывает снова — иначе вернувшийся человек писал бы туда, куда никто не смотрит.
    state         ChatConversationState @default(live)
    /// Минута, которой переписка последний раз будила оператора. Пусто — не будила ни разу.
    /// Ответ оператора её снимает: иначе одна переписка будила бы каждую минуту, и приложение
    /// научилось бы не смотреть на эти вызовы вовсе.
    wokeAt        DateTime?

    messages ChatMessage[]

    @@index([siteId, state, lastMessageAt])
    @@map("chat_conversation")
}

/// Сообщение: одна реплика разговора. Порядок задаёт минута приёма сервисом, а не часы
/// отправителя: неверные часы одной страницы перемешали бы разговор всем, кто его читает.
model ChatMessage {
    id             String           @id @default(uuid())
    conversationId String
    conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    /// Кто написал реплику.
    side           ChatSide
    /// Текст реплики целиком. Пустой не принимается, предел длины держит операция приёма.
    text           String
    /// Минута приёма сервисом.
    takenAt        DateTime         @default(now())

    @@index([conversationId, takenAt])
    @@map("chat_message")
}

/// Состояние переписки: жива она или закрыта. Двух слов хватает на весь эпик — третье сперва
/// пишется в договорённость, и только потом в код: набор читает экран, и значение, которого он не
/// знает, показывается машинной строкой.
enum ChatConversationState {
    /// Разговор идёт: он в списке оператора и ждёт ответа.
    live
    /// Разговор закрыт оператором. Реплика посетителя открывает его снова.
    closed
}

/// Оператор чата: человек пространства, который читает переписки и отвечает на них.
///
/// Учётную запись приёмника запись называет колонкой, а не связью: таблиц приёма чат не трогает —
/// связь завела бы обратное поле в чужой записи. Своей двери входа у оператора нет, и эпик её не
/// обещал: представляется он входом человека в приёмник.
model ChatOperator {
    id        String    @id @default(uuid())
    spaceId   String
    space     ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    /// Признак учётной записи приёмника, входом которой представляется оператор.
    accountId String
    createdAt DateTime  @default(now())

    sites ChatOperatorSite[]

    @@unique([spaceId, accountId])
    @@index([accountId])
    @@map("chat_operator")
}

/// За какие сайты отвечает оператор. Чего в этом наборе нет, того он не видит вовсе: набор идёт в
/// сам запрос чтения, а не отсеивается после него.
model ChatOperatorSite {
    operatorId String
    operator   ChatOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
    siteId     String
    site       ChatSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
    addedAt    DateTime     @default(now())

    @@id([operatorId, siteId])
    @@index([siteId])
    @@map("chat_operator_site")
}
