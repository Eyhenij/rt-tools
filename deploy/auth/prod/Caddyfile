# Дорога до общего Keycloak: все имена входа ведут в один Keycloak, сертификаты к ним выписывает
# сама дорога.
#
# Имена перечислены в `AUTH_HOSTS` окружения узла через запятую: у каждого продукта своё имя
# входа в своей зоне, и дерево их не знает.
{$AUTH_HOSTS} {
    reverse_proxy keycloak:8080

    encode zstd gzip
}
