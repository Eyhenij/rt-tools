# Дорога до приёмника: два имени, сертификаты к ним и разделение статики с приёмом.
#
# Сертификат Let's Encrypt выписывается и продлевается самим проксировщиком — отдельного
# тайминга и своего клиента ACME на узле нет. Зона `.dev` целиком в списке обязательного HTTPS,
# поэтому без сертификата приёмник браузеру недоступен вовсе.
#
# Увод с открытого протокола на защищённое проксировщик делает сам, без отдельного блока:
# дерево, оставшееся со старым адресом, узнаёт о переезде переездом, а не отказом.
message-bus.dev {
    # Приём и чтение — приёмнику. Порт наружу он не публикует: попасть в него можно только
    # изнутри сети состава.
    handle /api/* {
        reverse_proxy api:3000
    }

    # Всё остальное — прод-сборка админки, лежащая в этом же образе. Адрес раздела файлом не
    # является, и без `try_files` прямая ссылка на раздел отвечала бы отказом проксировщика —
    # то есть показывала бы поломкой приёмник, который тут ни при чём.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    # Сжатие даёт заметное на бандле админки и ничего не стоит на приёме: груз приезжает
    # запросом, а не ответом.
    encode zstd gzip
}

# Имя чата: тот же узел, тот же проксировщик и тот же сертификатчик. Отдельное имя нужно не
# сервису, а странице потребителя — она подключает виджет скриптом, и адрес в её коде читают
# люди.
#
# Отдаётся отсюда два рода запросов: открытые операции чата — приёмнику, файл виджета — из того
# же каталога, где лежит статика админки. Вход человека этим именем не пользуется вовсе:
# оператор работает в админке, на главном имени.
chat.message-bus.dev {
    # Позволение браузеру чужой страницы даёт приёмник, а не дорога: списки адресов лежат на
    # записях площадок, а дорога о площадках не знает ничего — её позволение было бы одно на всех.
    handle /api/* {
        reverse_proxy api:3000
    }

    # Файл виджета отдаётся любой странице: это скрипт, а не операция. Взявший его не получает
    # ничего без ключа площадки и её списка адресов.
    handle /widget.js {
        root * /srv
        file_server
    }

    # Остального по этому имени нет: админка живёт на главном, а вход человека кукой своего
    # адреса — отданная отсюда, она приезжала бы к приёмнику без входа.
    handle {
        respond 404
    }

    encode zstd gzip
}

# Доступ по голому адресу узла оставлен без сертификата и намеренно: он отвечает на вопрос
# «жив ли узел» тогда, когда имя ещё не разошлось по серверам имён или разошлось не туда.
http://168.144.241.107 {
    handle /api/* {
        reverse_proxy api:3000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
