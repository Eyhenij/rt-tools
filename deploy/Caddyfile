# Дорога до приёмника: имя, сертификат и разделение статики админки с приёмом.
#
# Сертификат Let's Encrypt выписывается и продлевается самим проксировщиком — отдельного
# тайминга и своего клиента ACME на узле нет. Зона `.dev` целиком в списке обязательного HTTPS,
# поэтому без сертификата приёмник браузеру недоступен вовсе.
#
# Увод с открытого протокола на защищённое проксировщик делает сам, без отдельного блока:
# дерево, оставшееся со старым адресом, узнаёт о переезде переездом, а не отказом.
message-bus.dev {
    # Приём и чтение — приёмнику. Порт наружу он не публикует: попасть в него можно только
    # изнутри сети состава.
    handle /api/* {
        reverse_proxy api:3000
    }

    # Всё остальное — прод-сборка админки, лежащая в этом же образе. Адрес раздела файлом не
    # является, и без `try_files` прямая ссылка на раздел отвечала бы отказом проксировщика —
    # то есть показывала бы поломкой приёмник, который тут ни при чём.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    # Сжатие даёт заметное на бандле админки и ничего не стоит на приёме: груз приезжает
    # запросом, а не ответом.
    encode zstd gzip
}

# Доступ по голому адресу узла оставлен без сертификата и намеренно: он отвечает на вопрос
# «жив ли узел» тогда, когда имя ещё не разошлось по серверам имён или разошлось не туда.
http://168.144.241.107 {
    handle /api/* {
        reverse_proxy api:3000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
