{
  "name": "auth-example-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "example",
  "sourceRoot": "apps/auth-example-admin/src",
  "tags": ["scope:auth-example-admin-app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/auth-example-admin",
        "browser": "apps/auth-example-admin/src/main.ts",
        "tsConfig": "apps/auth-example-admin/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*.svg",
            "input": "projects/ui-kit-v2/src/assets/icons",
            "output": "icons"
          },
          {
            "glob": "silent-check-sso.html",
            "input": "projects/auth-angular/src/assets",
            "output": "/"
          }
        ],
        "styles": ["apps/auth-example-admin/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/auth-example-admin/proxy.conf.json",
        "port": 4210
      },
      "configurations": {
        "production": {
          "buildTarget": "auth-example-admin:build:production"
        },
        "development": {
          "buildTarget": "auth-example-admin:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    }
  }
}
