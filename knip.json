{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@prisma/client", "@connectrpc/connect", "pdfjs-dist", "quill", "conventional-changelog-angular", "ts-node"],
  "ignoreBinaries": ["graphify"],
  "ignoreFiles": [
    "apps/message-bus/src/build/storage-client.check.d.mts",
    "libs/message-bus-admin/common/container/api/src/index.ts",
    "libs/message-bus-admin/invites/ui/src/index.ts",
    "libs/message-bus-api/access/api/src/index.ts",
    "libs/message-bus-api/access/data-access/src/index.ts",
    "libs/message-bus-api/cargo-state/data-access/src/index.ts",
    "libs/message-bus-api/observability/api/src/index.ts",
    "libs/message-bus-api/observability/data-access/src/index.ts",
    "libs/message-bus-api/observations/api/src/index.ts",
    "libs/message-bus-api/persistence/api/src/index.ts",
    "libs/message-bus-api/postmortems/api/src/index.ts",
    "libs/message-bus-api/proposals/api/src/index.ts",
    "libs/message-bus-api/trees/api/src/index.ts"
  ],
  "ignoreIssues": {
    "projects/cms-angular/src/lib/editor/editor-blocks.ts": ["duplicates"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "apps/*/src/main.ts",
        "apps/*/src/**/*.spec.ts",
        "apps/*/vite.config.mts",
        "apps/*/vitest.config.mts",
        "apps/*/webpack.config.mjs",
        "apps/*/eslint.config.mjs",
        "apps/*-e2e/playwright.config.ts",
        "apps/*-e2e/src/**/*.ts",
        "apps/*-e2e/stand/*.mjs",
        "libs/**/*.spec.ts",
        "libs/**/src/test-setup.ts",
        "libs/**/vitest.config.mts",
        "libs/**/eslint.config.mjs",
        "tools/*.{mjs,cjs}",
        "tools/stylelint-rules/*.{js,cjs,mjs}",
        "tools/nx-plugins/*.{js,cjs,mjs}",
        ".claude/workflows/*.js",
        "eslint/**/*.mjs"
      ],
      "project": ["apps/**/*.{ts,mts,mjs}", "libs/**/*.{ts,mts}", "tools/**/*.{js,mjs,cjs}", "eslint/**/*.mjs"]
    },
    "projects/*": {
      "entry": ["src/index.ts", "src/public-api.ts", "src/**/*.spec.ts", "*.config.{ts,mjs,cjs}"],
      "project": ["src/**/*.ts"]
    },
    "projects/agent-kit": {
      "entry": ["src/index.ts", "src/bin/*.ts", "src/**/*.spec.ts", "assets/**/*.{js,mjs,cjs}"],
      "project": ["src/**/*.ts", "assets/**/*.{js,mjs,cjs}"],
      "ignoreUnresolved": ["^\\./board[\\w-]*\\.mjs$", "^\\./task-new-queue\\.mjs$"]
    },
    "projects/auth-import": {
      "entry": ["src/index.ts", "src/bin.ts", "src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "projects/auth-keycloak-theme": {
      "entry": ["src/main.ts", "src/**/*.spec.ts", "*.config.{ts,mts,mjs}"],
      "project": ["src/**/*.ts"]
    },
    "projects/ui-kit-v2": {
      "entry": [
        "src/lib/components/*/index.ts",
        "src/**/*.spec.ts",
        "src/**/*.stories.ts",
        ".storybook/*.{ts,js}",
        "*.config.{ts,mjs,cjs}"
      ],
      "project": ["src/**/*.ts"]
    }
  }
}
