{
    "sourceRoots": [
        "projects",
        "apps",
        "libs"
    ],
    "portableDirs": [
        "projects/agent-kit/assets"
    ],
    "externalEnums": [
        {
            "package": "@rt-tools/utils",
            "dir": "esm/lib/interfaces"
        }
    ],
    "reuse": {
        "bundles": [
            "angular"
        ],
        "signals": ".claude/rt-kit/signals.json"
    },
    "e2eRoots": [
        "apps/message-bus-admin-e2e"
    ],
    "backendRoots": [
        "libs/message-bus-api/",
        "apps/message-bus/"
    ],
    "schemaFile": "",
    "migrationsDir": "",
    "families": [
        "message-bus-admin"
    ],
    "importScope": "@rt",
    "libPrefix": "admin",
    "noDependencyTags": [
        "scope:message-bus-common"
    ],
    "barrelFiles": [
        "index.ts",
        "public-api.ts"
    ],
    "pushGate": {
        "pipelineFile": ".github/workflows/ci.yml",
        "stepPattern": "^\\s*-\\s*name:\\s*(.+?)\\s*$",
        "steps": {
            "Install pnpm": {
                "skip": "подъём окружения задания; на своей машине оно уже поднято"
            },
            "Cache node_modules": {
                "skip": "кэш задания; локально зависимости уже стоят"
            },
            "Install dependencies": {
                "skip": "установка зависимостей задания; локально она сделана"
            },
            "Fetch main branch": {
                "skip": "гард пуша подтягивает главную ветку сам, перед подсчётом базы"
            },
            "Состав правки": {
                "skip": "считает признак текстовой ветки для остальных шагов; сам ничего не проверяет"
            },
            "Докер без помощника ключей": {
                "skip": "подготовка окружения раннера: на своей машине клиент идёт из сеанса пользователя и помощник ключей отвечает"
            },
            "Убрать за прогоном": {
                "skip": "уборка за раннером, а не проверка: на своей машине снимать нечего — образы и кэш нужны следующей сборке"
            },
            "Hook scenarios": "node tools/check-hooks.mjs",
            "Package boundary": "node tools/check-boundary.mjs",
            "Circular imports": "node tools/check-cycles.mjs",
            "Test, Lint, Typecheck, Build": "pnpm exec nx affected -t lint typecheck test build --parallel",
            "Hook suites": "pnpm exec nx affected -t test-hooks",
            "Stylelint": "pnpm run lint:styles",
            "E2E admin": "pnpm exec nx run message-bus-admin-e2e:e2e",
            "Visual tests": "node tools/visual-gate.mjs ui-kit",
            "Upload visual diffs": {
                "skip": "выгрузка следов прогона; смотреть их локально не на чем"
            },
            "Visual tests (ui-kit-v2)": "node tools/visual-gate.mjs ui-kit-v2",
            "Upload visual diffs (ui-kit-v2)": {
                "skip": "выгрузка следов прогона"
            },
            "Verify built packages": "pnpm exec nx affected -t verify --parallel",
            "Build API image": "docker build -f deploy/message-bus.Dockerfile -t message-bus:gate .",
            "Build web image": "docker build -f deploy/message-bus-web.Dockerfile -t message-bus-web:gate ."
        }
    },
    "board": {
        "owner": "Eyhenij",
        "repo": "rt-tools",
        "projectId": "PVT_kwHOBE82K84AjroZ",
        "statusFieldId": "PVTSSF_lAHOBE82K84AjroZzgcAY0U",
        "statusOptions": {
            "new": {
                "id": "e9c5e93d",
