{
  "vars": {},
  "layout": {
    "laws": "docs/constitution",
    "hooks": ".claude/hooks",
    "checks": "tools",
    "agents": ".claude/agents",
    "templates": ".claude/rt-kit/templates"
  },
  "postmortems": ".claude/rt-kit/postmortems",
  "rolesOff": ["strict-teacher"],
  "variants": {
    "host": "github"
  },
  "has": ["packages", "app", "admin"],
  "skip": [
    "hooks/commit-msg.sh",
    "hooks/dev-server-guard.sh",
    "hooks/qa-dataid-guard.sh",
    "hooks/sql-guard.sh",
    "hooks/sql-guard-request.sh",
    "hooks/sql-guard-parse.sh",
    "hooks/sql-guard-target.sh",
    "hooks/sql-guard-write.sh",
    "laws/application/locales.md",
    "laws/application/search-visibility.md",
    "laws/shared-code.md",
    "patterns/browser-verification-stand.md",
    "patterns/testing-e2e.md",
    "patterns/ts-procedure.md",
    "rules/api-layer.md"
  ],
  "intake": "https://message-bus.dev",
  "token": "~/.config/rt-tools-tree-token",
  "account": "~/.config/message-bus-cargo-account"
}
