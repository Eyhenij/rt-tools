{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh PostToolUse"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh PreCompact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh PreToolUse",
            "timeout": 1800
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Read the file .claude/hooks/ask-judge.md under the project root named by the field cwd of the hook input, and follow it exactly. The hook input: $ARGUMENTS",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh Stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "Read the file .claude/hooks/turn-judge.md under the project root named by the field cwd of the hook input, and follow it exactly. The hook input: $ARGUMENTS",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh UserPromptSubmit"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh SubagentStop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh SessionEnd"
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 1000000,
  "env": {
    "RT_WINDOW_TOKENS": "1000000",
    "RT_WINDOW_WARN_PCT": "40",
    "RT_WINDOW_STOP_PCT": "50",
    "RT_WINDOW_MARGIN_PCT": "5",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  }
}
