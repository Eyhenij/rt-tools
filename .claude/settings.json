{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh PostToolUse"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh PreCompact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh PreToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh Stop"
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 1000000,
  "env": {
    "RT_WINDOW_TOKENS": "1000000",
    "RT_WINDOW_WARN_PCT": "40",
    "RT_WINDOW_STOP_PCT": "50",
    "RT_WINDOW_MARGIN_PCT": "5",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  }
}
