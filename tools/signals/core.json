# rt-kit v0.28.0 · checks/signals/core.json · 62bfc907fdac · правится надстройкой, не здесь
{
  "about": "Признаки пакета @rt-tools/core: директивы BEM, доступ к среде и хранилищу браузера.",
  "signals": [
    { "key": "class-binding", "ext": ".html", "find": "\\[ngClass\\]|\\[class\\.", "instead": "директивы rtBlock, rtElem, [rtMod]" },
    {
      "key": "raw-storage",
      "ext": ".ts",
      "find": "(window\\.)?(local|session)Storage\\.",
      "instead": "службы хранилища @rt-tools/core"
    },
    {
      "key": "raw-media-query",
      "ext": ".ts",
      "find": "(^|[^.\\w#$])matchMedia\\(",
      "strip": "'[^'\\n]*'|\"[^\"\\n]*\"|`[^`]*`",
      "skipBackendRoots": true,
      "instead": "BreakpointsService"
    },
    {
      "key": "raw-window",
      "ext": ".ts",
      "find": "(^|[^.\\w#$])(window|document)\\.",
      "strip": "'[^'\\n]*'|\"[^\"\\n]*\"|`[^`]*`",
      "cancel": "(const|let|var)\\s+(window|document)\\b|\\b(window|document)\\s*:\\s*[A-Za-z{(]|\\((window|document)\\s*:",
      "skipBackendRoots": true,
      "instead": "PlatformService и токены среды @rt-tools/core"
    }
  ]
}
